# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Cấu hình môi trường chứa API Key (RẤT QUAN TRỌNG)
.env
.env.*
!.env.example

# Môi trường ảo Python (uv tao .venv theo mac dinh)
.venv/
venv/
env/
ENV/

# Thư mục cache model (HuggingFace / Ollama)
cache/
.cache/

# Cache tool (ruff, pytest) - tu sinh lai, khong can commit
.pytest_cache/
.ruff_cache/

# Skill-manager artifacts (caveman skill, cai qua /caveman) - khong
# thuoc code cua app, chi la config cho Claude Code trong may nay.
.agents/
.claude/
skills-lock.json

# Dữ liệu cache và DB local
data/chunks_cache/
data/*.pdf
data/*.json

# IDE & Editor files
.vscode/
.idea/
*.swp

# OS generated files
.DS_Store
Thumbs.db

# Ghi chú nội bộ / hướng dẫn cho AI - giữ trên máy, không public lên GitHub
project-memory/
CLAUDE.md

# Tai lieu noi bo - giu tren may, khong public len GitHub
docs/

# PDF paper dung de danh gia (Phase 3) - khong dua len GitHub
eval/papers/

# Cache query embedding cua eval (sinh lai duoc, ton quota Gemini) - khong commit
eval/cache/

# Secrets cua Streamlit (API_BASE, APP_API_KEY) - khong dua len GitHub
.streamlit/secrets.toml

# Web UI (Next.js)
web/node_modules/
web/.next/
web/test-results/
web/playwright-report/
