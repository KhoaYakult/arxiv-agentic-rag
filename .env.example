# CẤU HÌNH API KEYS (Mẫu để tham khảo)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
HF_TOKEN=hf_your_huggingface_token_here

# CẤU HÌNH THƯ MỤC LƯU TRỮ
DATA_DIR=data

# CẤU HÌNH MODEL
GROQ_MODEL_NAME=llama3-70b-8192
# Model Gemini cho LLM (gemini-2.0-flash đã bị Google tắt 2026-06-01;
# gemini-2.5-flash-lite trả 404 với key mới). Danh sách: client.models.list()
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# DEPLOY CÔNG KHAI (Vercel)
# Giới hạn upload PDF (MB). Vercel cắt request body ở 4.5 MB -> để 4.0.
# File lớn hơn: dùng POST /api/v1/papers/arxiv (server tự tải PDF từ arxiv.org).
MAX_UPLOAD_MB=4.0
# Để trống = không yêu cầu auth (dev local). Có giá trị = mọi route /api/v1 trừ
# /health và /health/db đòi header X-API-Key bằng đúng giá trị này.
APP_API_KEY=
# Origin được gọi API từ trình duyệt, phân tách bằng dấu phẩy. Khi deploy thêm URL
# Streamlit Cloud thật, ví dụ: http://localhost:8501,https://ten-app.streamlit.app
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Supabase Postgres - lưu papers/sections/chunks (app/storage/repository.py)
# VÀ chat history (AsyncPostgresSaver trong app/agent/rag_graph.py).
# Lấy tại: Supabase Project -> Connect -> tab URI. Nên dùng "Session pooler"
# (host aws-0-<region>.pooler.supabase.com) - Direct connection chỉ có IPv6,
# nhiều môi trường không kết nối được.
DATABASE_URL=postgresql://postgres:your_password@your_project.supabase.co:5432/postgres
